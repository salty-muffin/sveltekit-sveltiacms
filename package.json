		"@types/react": "19.2.18",
		"eslint": "^10.4.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.19.0",
		"globals": "^17.6.0",
		"immutable": "5.1.9",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.0",
		"sass": "^1.102.0",
		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
